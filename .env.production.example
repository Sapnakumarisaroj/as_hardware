# Production settings for the VPS (docker-compose.prod.yml). Placeholders only.
# On the server:  cp .env.production.example .env  &&  chmod 600 .env  &&  edit every CHANGE_ME
# .env is git-ignored: never commit it, never paste it into chats or tickets.
# Defaults not listed here come from backend/config/settings/base.py and .env.example.

# ---- Site ----
APP_NAME=AS Hardware and Plywood
SITE_DOMAIN=ashardwareandplywood.com
ACME_EMAIL=CHANGE_ME@example.com
FRONTEND_URL=https://ashardwareandplywood.com
# First entry is used by the container health check. www is redirected by Caddy and never reaches Django.
DJANGO_ALLOWED_HOSTS=ashardwareandplywood.com
CSRF_TRUSTED_ORIGINS=https://ashardwareandplywood.com
# Same-site API (nginx proxies /api/): no cross-origin requests to allow.
CORS_ALLOWED_ORIGINS=

# ---- Django ----
DJANGO_ENV=production
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE_ME
# Client → Caddy → nginx → Django: two proxies append to X-Forwarded-For.
TRUSTED_PROXY_COUNT=2
MAX_REQUEST_BYTES=12582912
LOG_LEVEL=INFO
# HSTS for this host only until every subdomain serves HTTPS (preload is hard to undo).
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# ---- PostgreSQL (private Docker network only; no port is published) ----
POSTGRES_DB=ashardware
POSTGRES_USER=ashardware
# Letters and digits only (it is placed in a URL):  python3 -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=CHANGE_ME

# ---- Delivery fee: ₹40 below the free-delivery threshold; shop policy is free delivery from ₹2,000 ----
DELIVERY_FEE=40.00
FREE_DELIVERY_MIN_ORDER=2000.00
# Customer cancellation: online within 5 minutes of ordering; ₹200 for a COD order already being prepared
CUSTOMER_CANCEL_WINDOW_MINUTES=5
COD_CANCELLATION_FEE=200.00

# ---- Payments: cash on delivery only at launch ----
# none = COD only; online payment is shown as unavailable. Production refuses "mock", and refuses "razorpay"
# unless all three Razorpay values are set. Leave the Razorpay values empty until live payments are approved.
PAYMENT_PROVIDER=none
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- SMS / OTP sign-in: off (no SMS gateway yet). Customers use mobile number + password. ----
OTP_LOGIN_ENABLED=False
SMS_PROVIDER=none
WHATSAPP_PROVIDER=mock

# ---- Email (order emails and password reset): the shop mailbox's SMTP details ----
EMAIL_HOST=CHANGE_ME
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=CHANGE_ME
EMAIL_HOST_PASSWORD=CHANGE_ME
DEFAULT_FROM_EMAIL=AS Hardware and Plywood <CHANGE_ME@example.com>

# ---- Invoices ----
INVOICE_SELLER_NAME=AS Hardware and Plywood
INVOICE_SELLER_ADDRESS=CHANGE_ME
INVOICE_SELLER_GSTIN=

# ---- Optional features: off on the first release ----
LLM_PROVIDER=none
SEMANTIC_EMBEDDER=hashing
VISION_PROVIDER=none
SPEECH_STT_PROVIDER=none
SPEECH_TTS_PROVIDER=none
ROUTING_PROVIDER=haversine
GEOCODING_PROVIDER=none

# ---- Frontend build (public values, compiled into the site; never secrets) ----
VITE_APP_NAME=AS Hardware and Plywood
VITE_SUPPORT_PHONE=7338192616
VITE_SUPPORT_WHATSAPP=917338192616
VITE_SUPPORT_EMAIL=ashardwareplywood@gmail.com
VITE_STORE_HOURS=Open 8 am to 8 pm all days
VITE_MAP_CENTER=12.9716,77.5946
# Blank = OpenStreetMap tiles (docs/FREE_TOOLS.md)
VITE_MAP_TILE_URL=

# ---- Releases: image tag used by docker-compose.prod.yml. Set to the git commit on every release
#      (docs/DEPLOYMENT.md › A4, A8); rollback = put the previous commit's tag back here. ----
RELEASE_TAG=current
