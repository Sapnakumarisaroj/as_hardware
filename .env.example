# Copy to `.env` (never commit `.env`). Values here are placeholders only.

# ---- App ----
APP_NAME=BoltRun
APP_VERSION=0.1.0

# ---- Django ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000
LOG_LEVEL=INFO

# ---- JWT ----
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Optional separate signing key (defaults to DJANGO_SECRET_KEY)
JWT_SIGNING_KEY=

# ---- Database (one URL; vendor chosen by scheme) ----
# PostgreSQL (preferred):  postgres://USER:PASS@HOST:5432/DB
# MySQL/MariaDB (shared):  mysql://USER:PASS@localhost:3306/DB   (also: pip install -r requirements/mysql.txt)
# SQLite (local fallback): leave DATABASE_URL unset -> backend/db.sqlite3
DATABASE_URL=
# Only used by the optional local docker-compose Postgres:
POSTGRES_DB=boltrun
POSTGRES_USER=boltrun
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# ---- Static / media paths (production: web-served folders on your host) ----
STATIC_ROOT=
MEDIA_ROOT=

# ---- Business rules ----
FAST_DELIVERY_MAX_MINUTES=60
# Flat delivery fee (INR) and the order value (after discounts) at which delivery becomes free
DELIVERY_FEE=40.00
FREE_DELIVERY_MIN_ORDER=499.00
# Days after delivery during which customers can request a return
RETURN_WINDOW_DAYS=7

# ---- Frontend (Vite; exposed to the browser â€” NEVER put secrets in VITE_* vars) ----
VITE_APP_NAME=BoltRun
VITE_API_BASE_URL=http://localhost:8000/api
VITE_SUPPORT_PHONE=
VITE_SUPPORT_WHATSAPP=

# ---- Integrations: every provider has a free/mock default. Paid services are opt-in. ----
# Payments: mock (dev only; blocked in prod) | razorpay.  COD always available.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# WhatsApp: mock (logs + stores messages) | meta (WhatsApp Business Cloud API)
WHATSAPP_PROVIDER=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# SMS: mock | msg91 | twilio
SMS_PROVIDER=mock
# Maps: osm (OpenStreetMap/Nominatim + haversine distance, free) | google
MAPS_PROVIDER=osm
NOMINATIM_USER_AGENT=BoltRun/0.1 (contact@example.com)
GOOGLE_MAPS_API_KEY=
# AI: none (rule-based fallbacks only) | ollama (local, free) | openai_compatible | anthropic
LLM_PROVIDER=none
LLM_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
ANTHROPIC_API_KEY=
# Background jobs: inline (run immediately) | cron (DB queue drained by `manage.py run_jobs` via cron)
BACKGROUND_JOBS_MODE=inline
# Email (prod SMTP — most hosting plans include a mailbox)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@example.com
