# Copy to `.env` (never commit `.env`). Values here are placeholders only.

# ---- App ----
APP_NAME=BoltRun
APP_VERSION=0.1.0

# ---- Django ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
# production on a server: DJANGO_ENV=production and DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_ENV=development
# Proxies in front of Django that add to X-Forwarded-For (0 = use REMOTE_ADDR)
TRUSTED_PROXY_COUNT=0
MAX_REQUEST_BYTES=12582912
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000
LOG_LEVEL=INFO

# ---- JWT ----
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Optional separate signing key (defaults to DJANGO_SECRET_KEY)
JWT_SIGNING_KEY=

# ---- Database (one URL; vendor chosen by scheme) ----
# PostgreSQL (preferred):  postgres://USER:PASS@HOST:5432/DB
# MySQL/MariaDB (shared):  mysql://USER:PASS@localhost:3306/DB   (also: pip install -r requirements/mysql.txt)
# SQLite (local fallback): leave DATABASE_URL unset -> backend/db.sqlite3
DATABASE_URL=
# Only used by the optional local docker-compose Postgres:
POSTGRES_DB=boltrun
POSTGRES_USER=boltrun
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# ---- Static / media paths (production: web-served folders on your host) ----
STATIC_ROOT=
MEDIA_ROOT=
# Proof-of-delivery photos. Must NOT be web-served: a folder outside every document root.
# Blank = backend/private_media
PRIVATE_MEDIA_ROOT=

# ---- Business rules ----
# Fast delivery is OFFERED only when the calculated delivery time is at most this (zones can set their own).
# It is a cutoff, not a promise: customers see the calculated minutes.
FAST_DELIVERY_MAX_MINUTES=60
# Default delivery fee (INR) and the order value (after discounts) at which delivery becomes free.
# Delivery zones can override both (Django admin → Delivery zones).
DELIVERY_FEE=40.00
FREE_DELIVERY_MIN_ORDER=499.00

# ---- Delivery estimate (Phase 9). Per-store preparation time and riders are set in the Django admin. ----
# Average rider speed in city traffic (km/h) and road distance per straight-line km
DELIVERY_AVG_SPEED_KMPH=18
ROAD_DISTANCE_FACTOR=1.35
# Minutes at the door (parking, stairs, handover)
DELIVERY_HANDOVER_MINUTES=4
# When every rider is out: minutes until one is expected back
DELIVERY_RIDER_TURNAROUND_MINUTES=35
# Standard (non-fast) delivery: minutes before a batch leaves, and the length of the window shown
STANDARD_DISPATCH_DELAY_MINUTES=120
STANDARD_WINDOW_MINUTES=120
# Fast delivery window shown after the estimated time
FAST_WINDOW_MINUTES=15
# Distance assumed when address and store share a PIN code but have no coordinates (km)
SAME_PIN_DISTANCE_KM=2.0
# Ship one order from several stores when no single store has everything
SPLIT_FULFILLMENT_ENABLED=true
MAX_SHIPMENTS_PER_ORDER=3
# A delivery partner based elsewhere may take a shipment when within this distance of the store (km)
DELIVERY_PARTNER_PICKUP_RADIUS_KM=3.0

# ---- Delivery partner workflow (Phase 10) ----
# The customer's delivery code: minutes it is valid, wrong tries before it is blocked,
# seconds before the customer can ask for another one
DELIVERY_OTP_TTL_MINUTES=30
DELIVERY_OTP_MAX_ATTEMPTS=5
DELIVERY_OTP_RESEND_SECONDS=60
# Require a photo to complete a delivery (the delivery code is always required)
DELIVERY_PROOF_REQUIRED=false
# What a delivery partner earns per completed job (INR): base + per km of the store-to-customer route
DELIVERY_EARNING_BASE=25.00
DELIVERY_EARNING_PER_KM=6.00
DELIVERY_EARNING_FAILED_ATTEMPT=0.00
# Days after delivery during which customers can request a return
RETURN_WINDOW_DAYS=7

# ---- Frontend (Vite; exposed to the browser — NEVER put secrets in VITE_* vars) ----
VITE_APP_NAME=BoltRun
VITE_API_BASE_URL=http://localhost:8000/api
VITE_SUPPORT_PHONE=
VITE_SUPPORT_WHATSAPP=
# Address map (Leaflet). Blank = OpenStreetMap tiles; the map opens here ("lat,lng") when an address has no pin yet
VITE_MAP_TILE_URL=
VITE_MAP_CENTER=18.5204,73.8567
# Slim strip above the storefront header (empty = hidden).
VITE_STORE_HOURS=Open 8 am to 8 pm all days

# ---- Integrations: every provider has a free/mock default. Paid services are opt-in. ----
# Payments: mock (dev only; blocked in prod) | razorpay.  COD always available.
# mock (development only) | razorpay | none (cash on delivery only: online payment shown as unavailable)
PAYMENT_PROVIDER=mock
# Razorpay dashboard → API keys (rzp_test_… for test mode). The key id is public; keep both secrets private.
# Webhook URL to register in Razorpay: https://<your-domain>/api/payments/webhooks/razorpay/
#   events: payment.captured, payment.failed, order.paid, refund.processed, refund.failed
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Unpaid online orders are cancelled after this many minutes (checked by `run_jobs`; the gateway is asked first)
PAYMENT_EXPIRY_MINUTES=30
PAYMENT_RECONCILE_AFTER_MINUTES=10
# WhatsApp: mock (records messages, sends nothing) | meta (WhatsApp Business Cloud API, approved templates) | none
WHATSAPP_PROVIDER=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
MESSAGING_TIMEOUT_SECONDS=10
# Stored phone numbers are 10 digits; this is added in front for WhatsApp/SMS
PHONE_COUNTRY_CODE=91
# SMS: mock | none (no paid gateway is implemented)
SMS_PROVIDER=mock
# Active orders this many minutes past their delivery estimate get one "running late" message (run_jobs)
DELIVERY_DELAY_NOTICE_MINUTES=15
# Maps (all free; the defaults make no network calls). Usage limits: docs/FREE_TOOLS.md
# Routing: haversine (offline estimate) | osrm (OpenStreetMap road routing; falls back to haversine on any error)
ROUTING_PROVIDER=haversine
# Public demo server: light use only (about 1 request/second, no SLA). Self-host for production traffic.
OSRM_BASE_URL=https://router.project-osrm.org
# Geocoding: none (map pin / PIN code table only) | nominatim (max 1 request/second; answers are cached in the database)
GEOCODING_PROVIDER=none
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Required by Nominatim's policy when enabled: your site name and a contact email
NOMINATIM_USER_AGENT=BoltRun/0.1 (contact@example.com)
MAPS_TIMEOUT_SECONDS=4
ROUTE_CACHE_SECONDS=86400
# AI: none (rule-based fallbacks only) | ollama (local, free) | openai_compatible | anthropic
LLM_PROVIDER=none
LLM_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
ANTHROPIC_API_KEY=
# Product search (Phase 13). Hybrid = keyword + related words + meaning; falls back to keyword search by itself.
CATALOG_SEARCH_BACKEND=apps.catalog.semantic.backend.HybridSearchBackend
# Embedder: hashing (built-in, no download) | sentence_transformers (local model, needs requirements/semantic.txt
# and ~1 GB RAM: VPS/own machine only) | none
SEMANTIC_EMBEDDER=hashing
SEMANTIC_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# true = never download the model at runtime (set after the first `manage.py rebuild_search_index`)
SEMANTIC_MODEL_LOCAL_ONLY=false
# Photo search (Phase 14): none | clip (local CLIP, requirements/semantic.txt; recommended for development)
# | ollama (e.g. VISION_MODEL=qwen2.5vl:3b) | openai_compatible | anthropic. Photos are never stored.
VISION_PROVIDER=none
# clip: clip-ViT-L-14 (default, ~1.7 GB) or clip-ViT-B-32 (lighter, weaker) · ollama: qwen2.5vl:3b
VISION_MODEL=
VISION_MODEL_LOCAL_ONLY=false
VISION_TIMEOUT_SECONDS=60
IMAGE_SEARCH_MAX_BYTES=8388608
IMAGE_SEARCH_MAX_PRODUCTS=8
THROTTLE_IMAGE_SEARCH=10/min
# Voice shopping (Phase 18). By default the customer's browser listens and speaks (nothing to set up).
# Server fallback for browsers without speech recognition: none | faster_whisper (local Whisper,
# requirements/speech.txt, ~1 GB RAM: VPS/own machine) | openai_compatible (any /audio/transcriptions server)
SPEECH_STT_PROVIDER=none
# faster_whisper: small (default, better Hindi) or base (faster) · openai_compatible: whisper-1
SPEECH_STT_MODEL=
# Server voice for browsers without one: none | openai_compatible (/audio/speech)
SPEECH_TTS_PROVIDER=none
SPEECH_TTS_MODEL=
SPEECH_TTS_VOICE=alloy
SPEECH_TTS_VOICE_HI=
# Blank = the OPENAI_COMPATIBLE_* values above
SPEECH_BASE_URL=
SPEECH_API_KEY=
SPEECH_MODEL_LOCAL_ONLY=false
VOICE_MAX_AUDIO_BYTES=2097152
VOICE_MAX_AUDIO_SECONDS=20
THROTTLE_VOICE=30/min
THROTTLE_VOICE_AUDIO=12/min
# Compatibility checks per minute (Phase 21)
THROTTLE_COMPATIBILITY=60/min
# Quantity AI (Phase 20): which pack combination to suggest: lowest_cost (default) or fewest_packs
QUANTITY_PACK_RULE=lowest_cost
# Background jobs: inline (run immediately) | cron (DB queue drained by `manage.py run_jobs` via cron)
BACKGROUND_JOBS_MODE=inline
# Email (prod SMTP — most hosting plans include a mailbox)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@example.com
